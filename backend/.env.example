# Get a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string from https://cloud.mongodb.com
MONGODB_URI=mongodb://localhost:27017

# Google Fact Check Tools API key from https://console.cloud.google.com
FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# Tavily search API key from https://tavily.com
SEARCH_API_KEY=your_search_api_key_here
